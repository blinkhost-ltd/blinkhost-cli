{
  "name": "@blinkhost/cli",
  "version": "2.9.0",
  "description": "Secure local and remote developer workflows for BlinkHost",
  "keywords": ["blinkhost", "deployment", "hosting", "cloud", "cli", "developer-tools"],
  "homepage": "https://app.blinkhost.me/docs/source-control/cli",
  "repository": { "type": "git", "url": "git+https://github.com/blinkhost-ltd/blinkhost-cli.git" },
  "bugs": { "url": "https://github.com/blinkhost-ltd/blinkhost-cli/issues" },
  "type": "module",
  "bin": { "blinkhost": "dist/cli.js" },
  "exports": { "./test/node-reporter": "./dist/local-test-node-reporter.js", "./test/go-runner": "./dist/local-test-go-runner.js", "./test/rust-runner": "./dist/local-test-rust-runner.js" },
  "files": ["dist/*.js", "dist/*.d.ts", "dist/local-development/*.mjs", "dist/local-development/*.json", "dist/local-development/README.md", "dist/local-development/hello.rs", "dist/javascript-runtime/*.js", "test-runners/python-unittest.py", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/package-local-tools.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm test"
  },
  "dependencies": { "yaml": "2.9.0" },
  "devDependencies": { "@types/node": "20.19.24", "typescript": "5.9.3" },
  "license": "MIT",
  "publishConfig": { "access": "public", "provenance": true }
}
